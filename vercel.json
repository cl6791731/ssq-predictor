{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/history.json", "dest": "/history.json" },
    { "src": "/predictor.js", "dest": "/predictor.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
